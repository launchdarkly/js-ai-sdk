{
  "name": "@launchdarkly/ai-bedrock-agents",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "LaunchDarkly <team@launchdarkly.com>",
  "description": "Amazon Bedrock Strands Agents provider for @launchdarkly/ai-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/launchdarkly/js-ai-sdk.git",
    "directory": "packages/bedrock-agents"
  },
  "homepage": "https://github.com/launchdarkly/js-ai-sdk",
  "bugs": {
    "url": "https://github.com/launchdarkly/js-ai-sdk/issues"
  },
  "keywords": [
    "launchdarkly",
    "ai",
    "aws",
    "bedrock",
    "strands",
    "agents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1124.0",
    "@launchdarkly/ai-server": "*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@strands-agents/sdk": "^1.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "latest"
  }
}

{
  "name": "@launchdarkly/ai-node",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "author": "LaunchDarkly <team@launchdarkly.com>",
  "description": "Node.js convenience wrapper for @launchdarkly/ai-server — bundles @launchdarkly/node-server-sdk so no peer dependency setup is required",
  "repository": {
    "type": "git",
    "url": "https://github.com/launchdarkly/js-ai-sdk.git",
    "directory": "packages/ai-node"
  },
  "homepage": "https://github.com/launchdarkly/js-ai-sdk",
  "bugs": {
    "url": "https://github.com/launchdarkly/js-ai-sdk/issues"
  },
  "keywords": [
    "launchdarkly",
    "ai",
    "feature-flags",
    "sdk",
    "node"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsup-node",
    "build": "tsup-node",
    "build:watch": "tsup-node --watch",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@launchdarkly/ai-server": "*",
    "@launchdarkly/node-server-sdk": "^9.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "latest"
  }
}

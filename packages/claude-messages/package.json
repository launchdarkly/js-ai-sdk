{
  "name": "@launchdarkly/ai-claude-messages",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "author": "LaunchDarkly <team@launchdarkly.com>",
  "description": "Anthropic Messages API provider for @launchdarkly/ai-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/launchdarkly/js-ai-sdk.git",
    "directory": "packages/claude-messages"
  },
  "homepage": "https://github.com/launchdarkly/js-ai-sdk",
  "bugs": {
    "url": "https://github.com/launchdarkly/js-ai-sdk/issues"
  },
  "keywords": [
    "launchdarkly",
    "ai",
    "anthropic",
    "claude"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsup-node",
    "build": "tsup-node",
    "build:watch": "tsup-node --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "api:check": "tsc --emitDeclarationOnly --declarationMap false --outDir temp/dts && api-extractor run",
    "api:update": "tsc --emitDeclarationOnly --declarationMap false --outDir temp/dts && api-extractor run --local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.103.0",
    "@launchdarkly/ai-server": "^0.4.0",
    "@opentelemetry/api": "^1.9.1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@opentelemetry/context-async-hooks": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9"
  }
}
